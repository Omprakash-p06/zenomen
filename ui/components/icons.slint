// ZenOmen icon set — hand-authored 20x20 line glyphs.
//
// `01-UI-SPEC.md` (Design System) fixes the rules: a 20x20 box, 2px stroke and
// a single colour bound to the surrounding text token. There is no icon
// library, so every glyph is SVG path data here and nowhere else. Names match
// the spec's inventory: enso, cpu, gpu, memory, fan, power, keyboard, settings,
// stethoscope, warning, unavailable. `diagnostics` is kept as an alias for
// `stethoscope` so older call sites keep compiling.
import { ThemeColors } from "../theme/colors.slint";

export component Icon inherits Rectangle {
    in property <string> name: "cpu";
    in property <color> tint: ThemeColors.text-secondary;
    in property <length> size: 20px;

    width: root.size;
    height: root.size;
    background: transparent;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 20;
        viewbox-height: 20;
        fill: transparent;
        stroke: root.tint;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: root.path-data;
    }

    // The complete glyph table. Each string is a full SVG path in the 20x20
    // viewbox above; multi-subpath strings draw compound icons (chip + pins).
    property <string> path-data:
        root.name == "enso"
            ? "M 14.4 4.6 A 7.2 7.2 0 1 0 15.4 12.4"
        : root.name == "cpu"
            ? "M 6 6 H 14 V 14 H 6 Z M 8.5 8.5 H 11.5 V 11.5 H 8.5 Z M 10 2.5 V 6 M 10 14 V 17.5 M 2.5 10 H 6 M 14 10 H 17.5"
        : root.name == "gpu"
            ? "M 2.5 6 H 17.5 V 14 H 2.5 Z M 7.5 10 A 2.5 2.5 0 1 0 12.5 10 A 2.5 2.5 0 1 0 7.5 10 M 5 16 H 15"
        : root.name == "memory"
            ? "M 2.5 7 H 17.5 V 13 H 2.5 Z M 6 13 V 16 M 10 13 V 16 M 14 13 V 16 M 6 9.5 H 14"
        : root.name == "fan"
            ? "M 8.4 10 A 1.6 1.6 0 1 0 11.6 10 A 1.6 1.6 0 1 0 8.4 10 M 10 8.4 C 10 4.5 12.2 3 14 4.2 C 15.2 6.2 13 8.4 10 8.4 M 11.4 10.9 C 14.8 12.2 15.2 14.8 13.9 16.1 C 11.8 15.9 10.6 13.7 11.4 10.9 M 8.6 10.9 C 5.2 12.2 4.8 14.8 6.1 16.1 C 8.2 15.9 9.4 13.7 8.6 10.9"
        : root.name == "power"
            ? "M 10 2.5 V 9.5 M 6.2 5.4 A 6.2 6.2 0 1 0 13.8 5.4"
        : root.name == "keyboard"
            ? "M 2.5 6.5 H 17.5 V 13.5 H 2.5 Z M 5 9 V 10.5 M 8 9 V 10.5 M 11 9 V 10.5 M 14 9 V 10.5 M 6.5 12 H 13.5"
        : root.name == "settings"
            ? "M 7.5 10 A 2.5 2.5 0 1 0 12.5 10 A 2.5 2.5 0 1 0 7.5 10 M 10 2 V 4 M 10 16 V 18 M 2 10 H 4 M 16 10 H 18 M 4.3 4.3 L 5.7 5.7 M 14.3 14.3 L 15.7 15.7 M 15.7 4.3 L 14.3 5.7 M 5.7 14.3 L 4.3 15.7"
        : root.name == "warning"
            ? "M 10 2.5 L 18 17 H 2 Z M 10 8 V 12 M 10 14.6 V 14.7"
        : root.name == "unavailable"
            ? "M 3 10 A 7 7 0 1 0 17 10 A 7 7 0 1 0 3 10 M 5.2 5.2 L 14.8 14.8"
        : root.name == "stethoscope" || root.name == "diagnostics"
            ? "M 6 2.5 V 7 A 4 4 0 0 0 14 7 V 2.5 M 4 2.5 H 8 M 12 2.5 H 16 M 10 11 V 13 A 2.5 2.5 0 0 0 15 13 V 11.5 M 13.5 10.5 A 1.5 1.5 0 1 0 16.5 10.5 A 1.5 1.5 0 1 0 13.5 10.5"
        : "";
}
