// ZenOmen Diagnostics screen.
//
// Complies with DIAG-01, DIAG-02, and DIAG-04:
// - Hardware & OS detection summary (OS, Kernel, Model, CPU Sensor, Fan count).
// - Subsystem capability table with availability status and missing reasons.
// - Hardware control service status and polkit authorization readiness (DIAG-04).
// - Export Diagnostics button triggering export to structured JSON.
import { ThemeColors } from "../theme/colors.slint";
import { ThemeTypography } from "../theme/typography.slint";
import { ThemeMetrics } from "../theme/metrics.slint";
import { StatusPill } from "../components/status-pill.slint";
import { SectionCard } from "../components/section-card.slint";
import { CapabilityNotice } from "../components/capability-notice.slint";
import { PrimaryButton } from "../components/action-button.slint";

export component Diagnostics inherits Rectangle {
    in property <string> os-name: "Linux";
    in property <string> kernel-version: "Unknown";
    in property <string> model-name: "Unknown";
    in property <string> cpu-sensor: "Unavailable";
    in property <string> fan-count: "0";
    in property <string> export-status: "";
    in property <string> service-status: "Disconnected";
    in property <string> polkit-status: "Unknown";
    in property <string> service-title: "Hardware Control Service (com.zenomen.Hardware1)";
    in property <string> auth-label: "Polkit Permissions:";
    in property <string> isolation-label: "Sandboxing:";
    in property <string> isolation-text: "ProtectSystem=strict, ReadWritePaths=/sys/devices/platform/hp-wmi /sys/firmware/acpi";
    in property <[string]> capability-names: [];
    in property <[bool]> capability-flags: [];
    in property <[string]> capability-reasons: [];

    callback export-diagnostics-clicked();

    background: transparent;

    VerticalLayout {
        spacing: ThemeMetrics.lg;
        alignment: start;

        SectionCard {
            title: "System & Sensor Bindings";

            VerticalLayout {
                spacing: ThemeMetrics.sm;
                alignment: start;

                HorizontalLayout {
                    spacing: ThemeMetrics.md;
                    Text {
                        text: "OS / Kernel:";
                        color: ThemeColors.text-secondary;
                        font-family: ThemeTypography.font-prose;
                        font-size: ThemeTypography.label;
                        letter-spacing: 0.5px;
                        width: 175px;
                    }
                    Text {
                        text: root.os-name + " (" + root.kernel-version + ")";
                        color: ThemeColors.text-primary;
                        font-family: ThemeTypography.font-prose;
                        font-size: ThemeTypography.body;
                        overflow: elide;
                    }
                }

                HorizontalLayout {
                    spacing: ThemeMetrics.md;
                    Text {
                        text: "Model / Vendor:";
                        color: ThemeColors.text-secondary;
                        font-family: ThemeTypography.font-prose;
                        font-size: ThemeTypography.label;
                        letter-spacing: 0.5px;
                        width: 175px;
                    }
                    Text {
                        text: root.model-name;
                        color: ThemeColors.text-primary;
                        font-family: ThemeTypography.font-prose;
                        font-size: ThemeTypography.body;
                        overflow: elide;
                    }
                }

                HorizontalLayout {
                    spacing: ThemeMetrics.md;
                    Text {
                        text: "CPU temperature sensor:";
                        color: ThemeColors.text-secondary;
                        font-family: ThemeTypography.font-prose;
                        font-size: ThemeTypography.label;
                        letter-spacing: 0.5px;
                        width: 175px;
                    }
                    Text {
                        text: root.cpu-sensor;
                        color: ThemeColors.text-primary;
                        font-family: ThemeTypography.font-mono;
                        font-size: ThemeTypography.label;
                        overflow: elide;
                    }
                }

                HorizontalLayout {
                    spacing: ThemeMetrics.md;
                    Text {
                        text: "Tachometers:";
                        color: ThemeColors.text-secondary;
                        font-family: ThemeTypography.font-prose;
                        font-size: ThemeTypography.label;
                        letter-spacing: 0.5px;
                        width: 175px;
                    }
                    Text {
                        text: root.fan-count + " fan tachometer(s) detected";
                        color: ThemeColors.text-primary;
                        font-family: ThemeTypography.font-prose;
                        font-size: ThemeTypography.body;
                        overflow: elide;
                    }
                }
            }
        }

        // Hardware Service & Authorization Diagnostics (DIAG-04)
        SectionCard {
            title: root.service-title;

            VerticalLayout {
                spacing: ThemeMetrics.sm;
                alignment: start;

                HorizontalLayout {
                    spacing: ThemeMetrics.md;
                    alignment: start;
                    Text {
                        text: "Service Status:";
                        color: ThemeColors.text-secondary;
                        font-family: ThemeTypography.font-prose;
                        font-size: ThemeTypography.label;
                        letter-spacing: 0.5px;
                        width: 175px;
                        vertical-alignment: center;
                    }
                    StatusPill {
                        status: root.service-status == "Connected" ? "ok" : "unavailable";
                        label: root.service-status;
                        glyph: root.service-status == "Connected" ? "" : "unavailable";
                        vertical-stretch: 0;
                    }
                }

                HorizontalLayout {
                    spacing: ThemeMetrics.md;
                    Text {
                        text: root.auth-label;
                        color: ThemeColors.text-secondary;
                        font-family: ThemeTypography.font-prose;
                        font-size: ThemeTypography.label;
                        letter-spacing: 0.5px;
                        width: 175px;
                    }
                    Text {
                        text: root.polkit-status;
                        color: ThemeColors.text-primary;
                        font-family: ThemeTypography.font-prose;
                        font-size: ThemeTypography.label;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }

                HorizontalLayout {
                    spacing: ThemeMetrics.md;
                    Text {
                        text: root.isolation-label;
                        color: ThemeColors.text-secondary;
                        font-family: ThemeTypography.font-prose;
                        font-size: ThemeTypography.label;
                        letter-spacing: 0.5px;
                        width: 175px;
                    }
                    Text {
                        text: root.isolation-text;
                        color: ThemeColors.text-secondary;
                        font-family: ThemeTypography.font-prose;
                        font-size: ThemeTypography.label;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
            }
        }

        SectionCard {
            title: "Capability summary";

            HorizontalLayout {
                spacing: ThemeMetrics.md;
                alignment: start;

                Text {
                    text: "Sensor interface";
                    color: ThemeColors.text-secondary;
                    font-family: ThemeTypography.font-prose;
                    font-size: ThemeTypography.label;
                    letter-spacing: 0.5px;
                    horizontal-stretch: 3;
                }
                Text {
                    text: "Status";
                    color: ThemeColors.text-secondary;
                    font-family: ThemeTypography.font-prose;
                    font-size: ThemeTypography.label;
                    letter-spacing: 0.5px;
                    width: 128px;
                }
                Text {
                    text: "Missing interface";
                    color: ThemeColors.text-secondary;
                    font-family: ThemeTypography.font-prose;
                    font-size: ThemeTypography.label;
                    letter-spacing: 0.5px;
                    horizontal-stretch: 4;
                }
            }

            if root.capability-names.length == 0 : Text {
                text: "Unavailable — no capability report has arrived yet.";
                color: ThemeColors.text-secondary;
                font-family: ThemeTypography.font-prose;
                font-size: ThemeTypography.body;
                horizontal-alignment: left;
                wrap: word-wrap;
            }

            for name[index] in root.capability-names : Rectangle {
                height: 40px;
                background: Math.mod(index, 2) == 0 ? ThemeColors.slate : transparent;

                HorizontalLayout {
                    padding-left: ThemeMetrics.sm;
                    padding-right: ThemeMetrics.sm;
                    spacing: ThemeMetrics.md;
                    alignment: start;

                    Text {
                        text: name;
                        color: ThemeColors.text-primary;
                        font-family: ThemeTypography.font-prose;
                        font-size: ThemeTypography.body;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 3;
                    }
                    Rectangle {
                        width: 128px;
                        height: 100%;
                        background: transparent;

                        VerticalLayout {
                            alignment: center;

                            StatusPill {
                                status: index < root.capability-flags.length && root.capability-flags[index]
                                    ? "ok"
                                    : "unavailable";
                                label: index < root.capability-flags.length && root.capability-flags[index]
                                    ? "Available"
                                    : "Unavailable";
                                glyph: index < root.capability-flags.length && root.capability-flags[index]
                                    ? ""
                                    : "unavailable";
                                vertical-stretch: 0;
                            }
                        }
                    }
                    Text {
                        text: index < root.capability-reasons.length
                            ? root.capability-reasons[index]
                            : "";
                        color: ThemeColors.text-secondary;
                        font-family: ThemeTypography.font-prose;
                        font-size: ThemeTypography.label;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 4;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: ThemeMetrics.md;
            alignment: start;

            PrimaryButton {
                label: "Export Diagnostics";
                clicked => {
                    root.export-diagnostics-clicked();
                }
            }

            if root.export-status != "" : Text {
                text: root.export-status;
                color: ThemeColors.text-secondary;
                font-family: ThemeTypography.font-prose;
                font-size: ThemeTypography.label;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
    }
}
