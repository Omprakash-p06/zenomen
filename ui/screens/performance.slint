// ZenOmen Performance screen.
//
// ACPI platform profile selection and combined presets (Quiet, Balanced, Gaming).
// Every hardware write is verified by read-back with retry/backoff in zenomen-hw.
// Combined presets report granular execution status via PresetResult (PWR-06).
import { ThemeColors } from "../theme/colors.slint";
import { ThemeTypography } from "../theme/typography.slint";
import { ThemeMetrics } from "../theme/metrics.slint";
import { ValueReadout } from "../components/value-readout.slint";
import { SectionCard } from "../components/section-card.slint";
import { UnavailablePanel } from "../components/unavailable-panel.slint";
import { CapabilityNotice } from "../components/capability-notice.slint";
import { SecondaryButton } from "../components/action-button.slint";

export component Performance inherits Rectangle {
    in property <bool> has-power-profiles: true;
    in property <bool> service-connected: false;
    /// Active profile name, empty when the interface did not report one.
    in property <string> power-profile: "";
    /// Advertised profiles from `platform_profile_choices`.
    in property <[string]> power-profile-choices: [];
    in property <string> pending-power-profile: "";
    in property <string> preset-result-message: "";
    in property <bool> preset-result-partial: false;
    in property <bool> preset-result-success: false;
    in property <string> control-error-message: "";

    callback set-power-profile(string);
    callback apply-preset(string);
    callback dismiss-error();
    callback open-diagnostics();

    background: transparent;

    VerticalLayout {
        spacing: ThemeMetrics.lg;
        alignment: start;

        // Error notification banner if verification or authorization failed
        if root.control-error-message != "" : Rectangle {
            background: ThemeColors.slate;
            border-width: ThemeMetrics.stroke-emphasis;
            border-color: ThemeColors.crimson;
            border-radius: 6px;

            HorizontalLayout {
                padding: ThemeMetrics.md;
                spacing: ThemeMetrics.md;
                alignment: space-between;

                VerticalLayout {
                    spacing: ThemeMetrics.xs;
                    alignment: center;
                    horizontal-stretch: 1;

                    Text {
                        text: "Hardware Control Error";
                        color: ThemeColors.crimson;
                        font-family: ThemeTypography.font-prose;
                        font-size: ThemeTypography.body;
                        font-weight: ThemeTypography.weight-semibold;
                    }
                    Text {
                        text: root.control-error-message;
                        color: ThemeColors.text-primary;
                        font-family: ThemeTypography.font-prose;
                        font-size: ThemeTypography.label;
                        wrap: word-wrap;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    SecondaryButton {
                        label: "Dismiss";
                        clicked => { root.dismiss-error(); }
                    }
                }
            }
        }

        // Granular Preset Result banner (PWR-06)
        if root.preset-result-message != "" : Rectangle {
            background: ThemeColors.slate;
            border-width: ThemeMetrics.stroke-hairline;
            border-color: root.preset-result-partial ? ThemeColors.gold : ThemeColors.status-ok;
            border-radius: 6px;

            HorizontalLayout {
                padding: ThemeMetrics.md;
                spacing: ThemeMetrics.md;
                alignment: space-between;

                VerticalLayout {
                    spacing: ThemeMetrics.xs;
                    alignment: center;
                    horizontal-stretch: 1;

                    Text {
                        text: root.preset-result-partial ? "Preset Partially Applied" : "Preset Applied";
                        color: root.preset-result-partial ? ThemeColors.gold : ThemeColors.status-ok;
                        font-family: ThemeTypography.font-prose;
                        font-size: ThemeTypography.body;
                        font-weight: ThemeTypography.weight-semibold;
                    }
                    Text {
                        text: root.preset-result-message;
                        color: ThemeColors.text-primary;
                        font-family: ThemeTypography.font-prose;
                        font-size: ThemeTypography.label;
                        wrap: word-wrap;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    SecondaryButton {
                        label: "Dismiss";
                        clicked => { root.dismiss-error(); }
                    }
                }
            }
        }

        // Combined Presets Card (PWR-05, PWR-06)
        if root.has-power-profiles : SectionCard {
            title: "Combined performance presets";

            VerticalLayout {
                spacing: ThemeMetrics.sm;
                alignment: start;

                Text {
                    text: "Coordinate ACPI power profiles and cooling fans together. Each preset verifies read-back and reports granular execution results.";
                    color: ThemeColors.text-secondary;
                    font-family: ThemeTypography.font-prose;
                    font-size: ThemeTypography.label;
                    wrap: word-wrap;
                }

                if root.service-connected : HorizontalLayout {
                    spacing: ThemeMetrics.md;
                    alignment: start;

                    // Quiet Preset
                    Rectangle {
                        width: 140px;
                        height: 48px;
                        background: ThemeColors.charcoal;
                        border-width: ThemeMetrics.stroke-hairline;
                        border-color: ThemeColors.outline;
                        border-radius: 6px;

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;

                            Text {
                                text: "Quiet";
                                color: ThemeColors.text-primary;
                                font-family: ThemeTypography.font-prose;
                                font-size: ThemeTypography.body;
                                font-weight: ThemeTypography.weight-semibold;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Cool profile · Auto fan";
                                color: ThemeColors.text-secondary;
                                font-family: ThemeTypography.font-prose;
                                font-size: 10px;
                                horizontal-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => { root.apply-preset("quiet"); }
                            mouse-cursor: pointer;
                        }
                    }

                    // Balanced Preset
                    Rectangle {
                        width: 140px;
                        height: 48px;
                        background: ThemeColors.charcoal;
                        border-width: ThemeMetrics.stroke-hairline;
                        border-color: ThemeColors.outline;
                        border-radius: 6px;

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;

                            Text {
                                text: "Balanced";
                                color: ThemeColors.text-primary;
                                font-family: ThemeTypography.font-prose;
                                font-size: ThemeTypography.body;
                                font-weight: ThemeTypography.weight-semibold;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Balanced profile · Auto fan";
                                color: ThemeColors.text-secondary;
                                font-family: ThemeTypography.font-prose;
                                font-size: 10px;
                                horizontal-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => { root.apply-preset("balanced"); }
                            mouse-cursor: pointer;
                        }
                    }

                    // Gaming Preset
                    Rectangle {
                        width: 140px;
                        height: 48px;
                        background: ThemeColors.charcoal;
                        border-width: ThemeMetrics.stroke-hairline;
                        border-color: ThemeColors.outline;
                        border-radius: 6px;

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;

                            Text {
                                text: "Gaming";
                                color: ThemeColors.gold;
                                font-family: ThemeTypography.font-prose;
                                font-size: ThemeTypography.body;
                                font-weight: ThemeTypography.weight-semibold;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Performance · Max fan";
                                color: ThemeColors.text-secondary;
                                font-family: ThemeTypography.font-prose;
                                font-size: 10px;
                                horizontal-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => { root.apply-preset("gaming"); }
                            mouse-cursor: pointer;
                        }
                    }
                }

                if !root.service-connected : CapabilityNotice {
                    text: "Hardware service is disconnected. Combined presets are disabled.";
                }
            }
        }

        // Active Profile Card (PWR-02)
        if root.has-power-profiles : SectionCard {
            title: "Active profile";

            ValueReadout {
                value: root.power-profile == "" ? "Unavailable" : root.power-profile;
                available: root.power-profile != "";
                value-size: ThemeTypography.heading;
            }
            Text {
                text: root.power-profile == ""
                    ? "platform_profile is readable but reported no active profile."
                    : "Verified by reading from ACPI platform_profile sysfs interface.";
                color: ThemeColors.text-secondary;
                font-family: ThemeTypography.font-prose;
                font-size: ThemeTypography.label;
                horizontal-alignment: left;
                wrap: word-wrap;
            }
        }

        // Advertised Profile Choices Card (PWR-01, PWR-03)
        if root.has-power-profiles : SectionCard {
            title: "Advertised platform profiles";

            if root.power-profile-choices.length == 0 : Text {
                text: "Unavailable — platform_profile_choices reported no profiles.";
                color: ThemeColors.text-secondary;
                font-family: ThemeTypography.font-prose;
                font-size: ThemeTypography.body;
                horizontal-alignment: left;
                wrap: word-wrap;
            }

            if root.power-profile-choices.length > 0 : VerticalLayout {
                spacing: ThemeMetrics.sm;
                alignment: start;

                for profile[index] in root.power-profile-choices : Rectangle {
                    height: 44px;
                    background: root.power-profile == profile ? ThemeColors.slate : ThemeColors.charcoal;
                    border-radius: 4px;
                    border-width: ThemeMetrics.stroke-hairline;
                    border-color: root.power-profile == profile ? ThemeColors.gold : ThemeColors.outline;

                    // Selected option: 2px gold rail on the left
                    if root.power-profile == profile : Rectangle {
                        x: 0;
                        width: ThemeMetrics.stroke-emphasis;
                        height: 100%;
                        background: ThemeColors.gold;
                    }

                    HorizontalLayout {
                        padding-left: ThemeMetrics.md;
                        padding-right: ThemeMetrics.md;
                        spacing: ThemeMetrics.sm;
                        alignment: space-between;

                        Text {
                            text: profile;
                            color: root.power-profile == profile
                                ? ThemeColors.text-primary
                                : ThemeColors.text-secondary;
                            font-family: ThemeTypography.font-prose;
                            font-size: ThemeTypography.body;
                            font-weight: root.power-profile == profile
                                ? ThemeTypography.weight-semibold
                                : ThemeTypography.weight-regular;
                            vertical-alignment: center;
                        }

                        if root.power-profile == profile : Text {
                            text: "Active";
                            color: ThemeColors.gold;
                            font-family: ThemeTypography.font-prose;
                            font-size: ThemeTypography.label;
                            vertical-alignment: center;
                        }

                        if root.power-profile != profile && root.service-connected : Text {
                            text: "Click to apply";
                            color: ThemeColors.text-disabled;
                            font-family: ThemeTypography.font-prose;
                            font-size: ThemeTypography.label;
                            vertical-alignment: center;
                        }
                    }

                    if root.service-connected : TouchArea {
                        clicked => {
                            if (root.power-profile != profile) {
                                root.set-power-profile(profile);
                            }
                        }
                        mouse-cursor: pointer;
                    }
                }
            }
        }

        if !root.has-power-profiles : UnavailablePanel {
            heading: "Platform profiles aren't available on this machine";
            reason: "ACPI platform_profile sysfs interface not exposed.";
            open-diagnostics => {
                root.open-diagnostics();
            }
        }
    }
}
