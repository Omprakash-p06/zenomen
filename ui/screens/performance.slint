// ZenOmen Performance screen.
//
// ACPI platform profile selection and combined presets (Quiet, Balanced, Gaming).
// Every hardware write is verified by read-back with retry/backoff in zenomen-hw.
// Combined presets report granular execution status via PresetResult (PWR-06).
import { ThemeColors } from "../theme/colors.slint";
import { ThemeTypography } from "../theme/typography.slint";
import { ThemeMetrics } from "../theme/metrics.slint";
import { ValueReadout } from "../components/value-readout.slint";
import { StatusPill } from "../components/status-pill.slint";
import { SectionCard } from "../components/section-card.slint";
import { UnavailablePanel } from "../components/unavailable-panel.slint";
import { CapabilityNotice } from "../components/capability-notice.slint";
import { SecondaryButton } from "../components/action-button.slint";
import { Icon } from "../components/icons.slint";

export component Performance inherits Rectangle {
    in property <bool> has-power-profiles: true;
    in property <bool> service-connected: false;
    in property <bool> is-windows: false;
    /// Active profile name, empty when the interface did not report one.
    in property <string> power-profile: "";
    /// Whether the active power profile has been confirmed by independent read-back.
    in property <bool> power-profile-verified: false;
    /// Advertised profiles from `platform_profile_choices`.
    in property <[string]> power-profile-choices: [];
    in property <string> pending-power-profile: "";
    in property <string> preset-result-message: "";
    in property <bool> preset-result-partial: false;
    in property <bool> preset-result-success: false;
    in property <string> control-error-message: "";
    in property <int> display-refresh-rate: 0;
    in property <string> fan-mode: "";
    in property <string> active-preset: "";

    callback set-power-profile(string);
    callback apply-preset(string);
    callback dismiss-error();
    callback request-service-elevation();
    callback open-diagnostics();

    background: transparent;

    VerticalLayout {
        spacing: ThemeMetrics.lg;
        alignment: start;

        // Error notification banner if verification or authorization failed
        if root.control-error-message != "" : Rectangle {
            background: ThemeColors.slate;
            border-width: ThemeMetrics.stroke-emphasis;
            border-color: ThemeColors.crimson;
            border-radius: 6px;

            HorizontalLayout {
                padding: ThemeMetrics.md;
                spacing: ThemeMetrics.md;
                alignment: space-between;

                VerticalLayout {
                    spacing: ThemeMetrics.xs;
                    alignment: center;
                    horizontal-stretch: 1;

                    Text {
                        text: "Hardware Control Error";
                        color: ThemeColors.crimson;
                        font-family: ThemeTypography.font-prose;
                        font-size: ThemeTypography.body;
                        font-weight: ThemeTypography.weight-semibold;
                    }
                    Text {
                        text: root.control-error-message;
                        color: ThemeColors.text-primary;
                        font-family: ThemeTypography.font-prose;
                        font-size: ThemeTypography.label;
                        wrap: word-wrap;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: ThemeMetrics.sm;
                        if !root.service-connected : SecondaryButton {
                            label: "Enable Service";
                            clicked => { root.request-service-elevation(); }
                        }
                        SecondaryButton {
                            label: "Dismiss";
                            clicked => { root.dismiss-error(); }
                        }
                    }
                }
            }
        }

        // Granular Preset Result banner (PWR-06)
        if root.preset-result-message != "" : Rectangle {
            background: ThemeColors.slate;
            border-width: ThemeMetrics.stroke-hairline;
            border-color: root.preset-result-partial ? ThemeColors.gold : ThemeColors.status-ok;
            border-radius: 6px;

            HorizontalLayout {
                padding: ThemeMetrics.md;
                spacing: ThemeMetrics.md;
                alignment: space-between;

                VerticalLayout {
                    spacing: ThemeMetrics.xs;
                    alignment: center;
                    horizontal-stretch: 1;

                    Text {
                        text: root.preset-result-partial ? "Preset Partially Applied" : "Preset Applied";
                        color: root.preset-result-partial ? ThemeColors.gold : ThemeColors.status-ok;
                        font-family: ThemeTypography.font-prose;
                        font-size: ThemeTypography.body;
                        font-weight: ThemeTypography.weight-semibold;
                    }
                    Text {
                        text: root.preset-result-message;
                        color: ThemeColors.text-primary;
                        font-family: ThemeTypography.font-prose;
                        font-size: ThemeTypography.label;
                        wrap: word-wrap;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    SecondaryButton {
                        label: "Dismiss";
                        clicked => { root.dismiss-error(); }
                    }
                }
            }
        }

        // Combined Presets Card (PWR-05, PWR-06)
        if root.has-power-profiles : SectionCard {
            title: "Combined performance presets";

            VerticalLayout {
                spacing: ThemeMetrics.md;
                alignment: start;

                Text {
                    text: root.is-windows
                        ? "Coordinate display refresh rate, platform power profile, and cooling fans with verified hardware read-back."
                        : "Coordinate ACPI power profiles and cooling fans together with verified read-back.";
                    color: ThemeColors.text-secondary;
                    font-family: ThemeTypography.font-prose;
                    font-size: ThemeTypography.label;
                    wrap: word-wrap;
                }

                if !root.service-connected : CapabilityNotice {
                    text: root.is-windows
                        ? "Hardware service (ZenOmenHardwareService) is offline. Display switching will still operate; hardware mutations require the service."
                        : "Hardware service (com.zenomen.Hardware1) is disconnected. Controls will request daemon connection when toggled.";
                }

                HorizontalLayout {
                    spacing: ThemeMetrics.md;

                    // Quiet Preset
                    Rectangle {
                        min-width: 140px;
                        horizontal-stretch: 1;
                        height: 68px;
                        background: root.active-preset == "quiet" ? ThemeColors.slate : ThemeColors.charcoal;
                        border-width: root.active-preset == "quiet" ? ThemeMetrics.stroke-emphasis : ThemeMetrics.stroke-hairline;
                        border-color: root.active-preset == "quiet" ? ThemeColors.gold : ThemeColors.outline;
                        border-radius: 8px;

                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;

                            Text {
                                text: "Quiet";
                                color: root.active-preset == "quiet" ? ThemeColors.gold : ThemeColors.text-primary;
                                font-family: ThemeTypography.font-prose;
                                font-size: ThemeTypography.body;
                                font-weight: ThemeTypography.weight-semibold;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "60 Hz · Quiet · Auto";
                                color: ThemeColors.text-secondary;
                                font-family: ThemeTypography.font-prose;
                                font-size: ThemeTypography.label;
                                horizontal-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => { root.apply-preset("quiet"); }
                            mouse-cursor: pointer;
                        }
                    }

                    // Balanced Preset
                    Rectangle {
                        min-width: 140px;
                        horizontal-stretch: 1;
                        height: 68px;
                        background: root.active-preset == "balanced" ? ThemeColors.slate : ThemeColors.charcoal;
                        border-width: root.active-preset == "balanced" ? ThemeMetrics.stroke-emphasis : ThemeMetrics.stroke-hairline;
                        border-color: root.active-preset == "balanced" ? ThemeColors.gold : ThemeColors.outline;
                        border-radius: 8px;

                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;

                            Text {
                                text: "Balanced";
                                color: root.active-preset == "balanced" ? ThemeColors.gold : ThemeColors.text-primary;
                                font-family: ThemeTypography.font-prose;
                                font-size: ThemeTypography.body;
                                font-weight: ThemeTypography.weight-semibold;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "144 Hz · Balanced · Auto";
                                color: ThemeColors.text-secondary;
                                font-family: ThemeTypography.font-prose;
                                font-size: ThemeTypography.label;
                                horizontal-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => { root.apply-preset("balanced"); }
                            mouse-cursor: pointer;
                        }
                    }

                    // Auto Preset
                    Rectangle {
                        min-width: 140px;
                        horizontal-stretch: 1;
                        height: 68px;
                        background: root.active-preset == "auto" ? ThemeColors.slate : ThemeColors.charcoal;
                        border-width: root.active-preset == "auto" ? ThemeMetrics.stroke-emphasis : ThemeMetrics.stroke-hairline;
                        border-color: root.active-preset == "auto" ? ThemeColors.gold : ThemeColors.outline;
                        border-radius: 8px;

                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;

                            Text {
                                text: "Auto";
                                color: root.active-preset == "auto" ? ThemeColors.gold : ThemeColors.text-primary;
                                font-family: ThemeTypography.font-prose;
                                font-size: ThemeTypography.body;
                                font-weight: ThemeTypography.weight-semibold;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "144 Hz · Default · Auto";
                                color: ThemeColors.text-secondary;
                                font-family: ThemeTypography.font-prose;
                                font-size: ThemeTypography.label;
                                horizontal-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => { root.apply-preset("auto"); }
                            mouse-cursor: pointer;
                        }
                    }

                    // Performance Preset
                    Rectangle {
                        min-width: 140px;
                        horizontal-stretch: 1;
                        height: 68px;
                        background: (root.active-preset == "performance" || root.active-preset == "gaming") ? ThemeColors.slate : ThemeColors.charcoal;
                        border-width: (root.active-preset == "performance" || root.active-preset == "gaming") ? ThemeMetrics.stroke-emphasis : ThemeMetrics.stroke-hairline;
                        border-color: (root.active-preset == "performance" || root.active-preset == "gaming") ? ThemeColors.gold : ThemeColors.outline;
                        border-radius: 8px;

                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;

                            Text {
                                text: "Performance";
                                color: (root.active-preset == "performance" || root.active-preset == "gaming") ? ThemeColors.gold : ThemeColors.text-primary;
                                font-family: ThemeTypography.font-prose;
                                font-size: ThemeTypography.body;
                                font-weight: ThemeTypography.weight-semibold;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "144 Hz · Performance · Max";
                                color: ThemeColors.text-secondary;
                                font-family: ThemeTypography.font-prose;
                                font-size: ThemeTypography.label;
                                horizontal-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => { root.apply-preset("performance"); }
                            mouse-cursor: pointer;
                        }
                    }
                }

                // Live Component Status Readout
                HorizontalLayout {
                    spacing: ThemeMetrics.md;

                    Rectangle {
                        horizontal-stretch: 1;
                        background: ThemeColors.charcoal;
                        border-width: ThemeMetrics.stroke-hairline;
                        border-color: ThemeColors.outline;
                        border-radius: 6px;
                        height: 52px;

                        VerticalLayout {
                            alignment: center;
                            padding-left: ThemeMetrics.md;
                            padding-right: ThemeMetrics.md;
                            spacing: 2px;

                            Text {
                                text: "Display";
                                color: ThemeColors.text-secondary;
                                font-family: ThemeTypography.font-prose;
                                font-size: ThemeTypography.label;
                            }
                            Text {
                                text: root.display-refresh-rate > 0
                                    ? (root.display-refresh-rate + " Hz — Verified")
                                    : "Active — Verified";
                                color: ThemeColors.status-ok;
                                font-family: ThemeTypography.font-prose;
                                font-size: ThemeTypography.label;
                                font-weight: ThemeTypography.weight-semibold;
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: ThemeColors.charcoal;
                        border-width: ThemeMetrics.stroke-hairline;
                        border-color: ThemeColors.outline;
                        border-radius: 6px;
                        height: 52px;

                        VerticalLayout {
                            alignment: center;
                            padding-left: ThemeMetrics.md;
                            padding-right: ThemeMetrics.md;
                            spacing: 2px;

                            Text {
                                text: "Cooling Fan";
                                color: ThemeColors.text-secondary;
                                font-family: ThemeTypography.font-prose;
                                font-size: ThemeTypography.label;
                            }
                            Text {
                                text: root.fan-mode == "max"
                                    ? "Max Fan — Verified"
                                    : (root.fan-mode != "" ? (root.fan-mode + " — Verified") : "Auto Fan — Verified");
                                color: root.fan-mode == "max" ? ThemeColors.gold : ThemeColors.status-ok;
                                font-family: ThemeTypography.font-prose;
                                font-size: ThemeTypography.label;
                                font-weight: ThemeTypography.weight-semibold;
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: ThemeColors.charcoal;
                        border-width: ThemeMetrics.stroke-hairline;
                        border-color: ThemeColors.outline;
                        border-radius: 6px;
                        height: 52px;

                        VerticalLayout {
                            alignment: center;
                            padding-left: ThemeMetrics.md;
                            padding-right: ThemeMetrics.md;
                            spacing: 2px;

                            Text {
                                text: "Platform Profile";
                                color: ThemeColors.text-secondary;
                                font-family: ThemeTypography.font-prose;
                                font-size: ThemeTypography.label;
                            }
                            Text {
                                text: root.power-profile != ""
                                    ? (root.power-profile-verified
                                        ? (root.power-profile + " — Verified")
                                        : (root.power-profile + " — Accepted, unverified"))
                                    : (root.is-windows ? "Accepted, unverified (8A3D)" : "Managed");
                                color: (root.power-profile != "" && root.power-profile-verified)
                                    ? ThemeColors.status-ok
                                    : ThemeColors.gold;
                                font-family: ThemeTypography.font-prose;
                                font-size: ThemeTypography.label;
                                font-weight: ThemeTypography.weight-semibold;
                            }
                        }
                    }
                }

                if !root.service-connected : Rectangle {
                    background: ThemeColors.slate;
                    border-width: ThemeMetrics.stroke-hairline;
                    border-color: ThemeColors.outline;
                    border-radius: 6px;

                    HorizontalLayout {
                        padding: ThemeMetrics.md;
                        spacing: ThemeMetrics.md;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: root.is-windows
                                    ? "Hardware service (ZenOmenHardwareService) is offline. Start the service to apply performance presets."
                                    : "Hardware service (com.zenomen.Hardware1) is disconnected. Enable it to apply hardware changes.";
                                color: ThemeColors.text-secondary;
                                font-family: ThemeTypography.font-prose;
                                font-size: ThemeTypography.label;
                                wrap: word-wrap;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            SecondaryButton {
                                label: "Enable Service";
                                clicked => { root.request-service-elevation(); }
                            }
                        }
                    }
                }
            }
        }

        // ACPI Platform Profiles (PWR-01, PWR-02, PWR-03)
        if root.has-power-profiles : SectionCard {
            title: "ACPI platform profiles";

            VerticalLayout {
                spacing: ThemeMetrics.md;
                alignment: start;

                HorizontalLayout {
                    spacing: ThemeMetrics.md;
                    alignment: start;

                    VerticalLayout {
                        alignment: center;
                        StatusPill {
                            status: root.power-profile == "" ? "unavailable" : "info";
                            label: root.power-profile == "" ? "Unavailable" : root.power-profile;
                            glyph: root.power-profile == "" ? "unavailable" : "";
                        }
                    }

                    Text {
                        text: root.pending-power-profile != ""
                            ? "Applying " + root.pending-power-profile + " and verifying read-back..."
                            : (root.is-windows
                                ? (root.power-profile-verified
                                    ? "Platform profile control via HP WMI interface (command 0x1A) — verified."
                                    : "Platform profile control via HP WMI interface (command 0x1A) — accepted unverified (EC register 0x95).")
                                : "Verified by reading and writing ACPI platform_profile sysfs interface.");
                        color: root.pending-power-profile != "" ? ThemeColors.gold : ThemeColors.text-secondary;
                        font-family: ThemeTypography.font-prose;
                        font-size: ThemeTypography.label;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }

                if root.power-profile-choices.length == 0 : Text {
                    text: "Unavailable — platform_profile_choices reported no profiles.";
                    color: ThemeColors.text-secondary;
                    font-family: ThemeTypography.font-prose;
                    font-size: ThemeTypography.body;
                    horizontal-alignment: left;
                    wrap: word-wrap;
                }

                if root.power-profile-choices.length > 0 : HorizontalLayout {
                    spacing: ThemeMetrics.md;

                    for profile[index] in root.power-profile-choices : Rectangle {
                        min-width: 140px;
                        horizontal-stretch: 1;
                        height: 58px;
                        background: root.power-profile == profile ? ThemeColors.slate : ThemeColors.charcoal;
                        border-radius: 8px;
                        border-width: root.power-profile == profile ? ThemeMetrics.stroke-emphasis : ThemeMetrics.stroke-hairline;
                        border-color: root.power-profile == profile ? ThemeColors.gold : ThemeColors.outline;

                        HorizontalLayout {
                            padding-left: ThemeMetrics.md;
                            padding-right: ThemeMetrics.md;
                            spacing: ThemeMetrics.sm;
                            alignment: space-between;

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: profile;
                                    color: root.power-profile == profile
                                        ? ThemeColors.gold
                                        : ThemeColors.text-primary;
                                    font-family: ThemeTypography.font-prose;
                                    font-size: ThemeTypography.body;
                                    font-weight: root.power-profile == profile
                                        ? ThemeTypography.weight-semibold
                                        : ThemeTypography.weight-regular;
                                    vertical-alignment: center;
                                }
                            }

                            if root.power-profile == profile : VerticalLayout {
                                alignment: center;
                                StatusPill {
                                    status: "nominal";
                                    label: "Active";
                                    vertical-stretch: 0;
                                }
                            }
                        }

                        TouchArea {
                            clicked => {
                                if (root.power-profile != profile && root.pending-power-profile == "") {
                                    root.set-power-profile(profile);
                                }
                            }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }
        }

        if !root.has-power-profiles : UnavailablePanel {
            heading: "Platform profiles aren't available on this machine";
            reason: root.is-windows
                ? (root.service-connected
                    ? "Platform power profiles are not supported by this motherboard."
                    : "Hardware service (ZenOmenHardwareService) is offline.")
                : "ACPI platform_profile sysfs interface not exposed.";
            open-diagnostics => {
                root.open-diagnostics();
            }
        }
    }
}
