// ZenOmen application window — shell and screen router.
//
// Layout from `01-UI-SPEC.md` (Visual Hierarchy): a fixed 200px Charcoal
// sidebar, then a vertical stack of the 64px header, the 40px status strip and
// a scrolling content area with 24px padding. Sidebar and header stay fixed
// while content scrolls.
//
// Two rules this file exists to enforce:
//   * No hardware access: the shell only reads Slint properties and emits
//     callbacks. `src/app.rs` turns those callbacks into `AppCommand`s and is
//     the only path back in (FOUND-05).
//   * A bad screen index can never blank the window: every read goes through
//     `current-screen`, which falls back to Overview (T-01-04).
import { ThemeColors } from "theme/colors.slint";
import { ThemeTypography } from "theme/typography.slint";
import { ThemeMetrics } from "theme/metrics.slint";
import { ScrollView } from "std-widgets.slint";

import { Sidebar } from "components/sidebar.slint";
import { ScreenHeader } from "components/screen-header.slint";
import { StatusStrip } from "components/status-strip.slint";
import { Overview } from "screens/overview.slint";
import { Cooling } from "screens/cooling.slint";
import { Performance } from "screens/performance.slint";
import { Lighting } from "screens/lighting.slint";
import { Settings } from "screens/settings.slint";
import { Diagnostics } from "screens/diagnostics.slint";

export component AppWindow inherits Window {
    title: "ZenOmen";
    background: ThemeColors.obsidian;

    // 1180x760 default, 940x620 minimum: the sizes the Overview grid's 4- and
    // 3-column breakpoints were designed against. Slint names the initial size
    // `preferred-width`/`preferred-height`; there is no `default-width`
    // property on Window.
    preferred-width: ThemeMetrics.default-width;
    preferred-height: ThemeMetrics.default-height;
    min-width: ThemeMetrics.min-width;
    min-height: ThemeMetrics.min-height;

    /// Screen index requested by the sidebar or by the core. 0 = Overview.
    in-out property <int> active-screen: 0;

    // ---- Capability flags -------------------------------------------------
    // Granular per-subsystem truth from `HardwareCapabilities` (FOUND-04).
    // Each screen names the exact interface that is missing instead of showing
    // one coarse "unsupported" state. Defaults describe the Phase 1 mock
    // provider; `src/app.rs` overwrites them from `AppEvent::CapabilitiesLoaded`.
    in-out property <bool> has-cpu-metrics: true;
    in-out property <bool> has-gpu-metrics: true;
    in-out property <bool> has-ram-metrics: true;
    in-out property <bool> has-fan-rpm: true;
    in-out property <bool> has-fan-control: true;
    in-out property <bool> has-power-profiles: true;
    in-out property <bool> has-rgb-lighting: true;
    in-out property <bool> has-battery-metrics: true;

    // ---- Global status ----------------------------------------------------
    // The one line under the header. Written by `src/app.rs` from `AppState`;
    // the default here is the pre-sample copy, so the window is never blank
    // between launch and the first event.
    in-out property <string> status-text: "Mock provider · waiting for first reading";
    in-out property <bool> status-degraded: false;

    // ---- About ------------------------------------------------------------
    in-out property <string> app-version: "0.1.0";
    in-out property <string> provider-mode: "mock";
    in-out property <string> theme-name: "Dark";

    // ---- Telemetry (already formatted by the core) ------------------------
    // The UI never reads a sensor and never invents a number: these are empty
    // or "Waiting for first reading" until a snapshot arrives.
    in-out property <string> cpu-utilization: "";
    in-out property <string> gpu-utilization: "";
    in-out property <string> gpu-temperature: "";
    in-out property <string> ram-usage: "";
    in-out property <string> fan-1-value: "";
    in-out property <string> fan-2-value: "";
    in-out property <string> fan-mode: "";
    in-out property <string> power-profile: "";
    in-out property <[string]> power-profile-choices: [];
    in-out property <string> rgb-profile: "";
    in-out property <[color]> zone-colors: [];

    in-out property <string> cpu-sparkline: "";
    in-out property <string> gpu-sparkline: "";
    in-out property <string> ram-sparkline: "";
    in-out property <string> cpu-path: "";
    in-out property <string> gpu-path: "";
    in-out property <string> ram-path: "";

    // ---- Diagnostics table ------------------------------------------------
    private property <[string]> capability-names: [
        "CPU metrics",
        "GPU metrics",
        "RAM metrics",
        "Fan speed (RPM)",
        "Fan control",
        "Power profiles",
        "RGB lighting",
        "Battery",
    ];
    private property <[bool]> capability-flags: [
        root.has-cpu-metrics,
        root.has-gpu-metrics,
        root.has-ram-metrics,
        root.has-fan-rpm,
        root.has-fan-control,
        root.has-power-profiles,
        root.has-rgb-lighting,
        root.has-battery-metrics,
    ];
    private property <[string]> capability-reasons: [
        root.has-cpu-metrics ? "" : "No CPU temperature hwmon device (coretemp/k10temp) found.",
        root.has-gpu-metrics ? "" : "No NVIDIA nvidia-smi or supported DRM card detected.",
        root.has-ram-metrics ? "" : "/proc/meminfo could not be read.",
        root.has-fan-rpm ? "" : "No fan tachometer found in hwmon.",
        root.has-fan-control ? "" : "hp-wmi exposes no writable pwm1_enable here.",
        root.has-power-profiles ? "" : "ACPI platform_profile sysfs interface not exposed.",
        root.has-rgb-lighting ? "" : "No supported OMEN 4-zone or legacy interface detected.",
        root.has-battery-metrics ? "" : "No /sys/class/power_supply battery device found.",
    ];

    /// Emitted when the user activates a nav row. `src/app.rs` forwards this
    /// to the core as `AppCommand::Navigate`.
    callback navigate(int);
    /// Emitted by the header's `Refresh Telemetry` action.
    callback refresh-telemetry();

    /// Index actually rendered. Out-of-range input degrades to Overview rather
    /// than rendering nothing (threat T-01-04).
    private property <int> current-screen:
        root.active-screen >= 0 && root.active-screen <= 5 ? root.active-screen : 0;

    // Title per screen, indexed by `current-screen`. A plain array keeps the
    // lookup inside a property binding (a function call would be impure).
    private property <[string]> screen-titles: [
        "Overview",
        "Cooling",
        "Performance",
        "Lighting",
        "Settings",
        "Diagnostics",
    ];

    // Root focus scope: Escape clears focus from the content and returns it to
    // the sidebar's active row (Keyboard & Interaction contract). Key events
    // from any focused descendant bubble up to here.
    shell-focus := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                sidebar.focus-active-row();
                return accept;
            }
            reject
        }

        HorizontalLayout {
            sidebar := Sidebar {
                active-screen: root.current-screen;
                navigate(screen) => {
                    root.active-screen = screen;
                    root.navigate(screen);
                }
            }

            VerticalLayout {
                spacing: 0;

                ScreenHeader {
                    title: root.screen-titles[root.current-screen];
                    // Only Overview has a primary action in Phase 1.
                    show-action: root.current-screen == 0;
                    action-label: "Refresh Telemetry";
                    action => {
                        root.refresh-telemetry();
                    }
                }

                // Global capability / provider state, directly under the header
                // so it is read before the screen anchor (UI-SPEC reading order).
                // Both values come from `src/app.rs`; nothing here decides
                // whether the machine is degraded.
                StatusStrip {
                    text: root.status-text;
                    degraded: root.status-degraded;
                    // A degraded machine always offers the way to the reason.
                    show-action: root.status-degraded;
                    action => {
                        root.active-screen = 5;
                        root.navigate(5);
                    }
                }

                // Content viewport: 24px padding, one scrolling surface. The
                // router keys on `current-screen`; every screen is instantiated
                // here so the Slint compiler type-checks each of them.
                Rectangle {
                    background: ThemeColors.obsidian;
                    vertical-stretch: 1;

                    ScrollView {
                        width: 100%;
                        height: 100%;

                        VerticalLayout {
                            padding: ThemeMetrics.lg;
                            spacing: ThemeMetrics.lg;
                            alignment: start;

                            if root.current-screen == 0 : Overview {
                                has-cpu-metrics: root.has-cpu-metrics;
                                has-gpu-metrics: root.has-gpu-metrics;
                                has-ram-metrics: root.has-ram-metrics;
                                has-fan-rpm: root.has-fan-rpm;
                                cpu-utilization: root.cpu-utilization;
                                gpu-utilization: root.gpu-utilization;
                                gpu-temperature: root.gpu-temperature;
                                ram-usage: root.ram-usage;
                                fan-1-value: root.fan-1-value;
                                fan-2-value: root.fan-2-value;
                                cpu-sparkline: root.cpu-sparkline;
                                gpu-sparkline: root.gpu-sparkline;
                                ram-sparkline: root.ram-sparkline;
                                cpu-path: root.cpu-path;
                                gpu-path: root.gpu-path;
                                ram-path: root.ram-path;
                                open-diagnostics => {
                                    root.active-screen = 5;
                                    root.navigate(5);
                                }
                            }

                            if root.current-screen == 1 : Cooling {
                                has-fan-rpm: root.has-fan-rpm;
                                has-fan-control: root.has-fan-control;
                                fan-mode: root.fan-mode;
                                fan-values: [root.fan-1-value, root.fan-2-value];
                                open-diagnostics => {
                                    root.active-screen = 5;
                                    root.navigate(5);
                                }
                            }

                            if root.current-screen == 2 : Performance {
                                has-power-profiles: root.has-power-profiles;
                                power-profile: root.power-profile;
                                power-profile-choices: root.power-profile-choices;
                                open-diagnostics => {
                                    root.active-screen = 5;
                                    root.navigate(5);
                                }
                            }

                            if root.current-screen == 3 : Lighting {
                                has-rgb-lighting: root.has-rgb-lighting;
                                rgb-profile: root.rgb-profile;
                                zone-colors: root.zone-colors;
                                open-diagnostics => {
                                    root.active-screen = 5;
                                    root.navigate(5);
                                }
                            }

                            if root.current-screen == 4 : Settings {
                                app-version: root.app-version;
                                provider-mode: root.provider-mode;
                                theme-name: root.theme-name;
                            }

                            if root.current-screen == 5 : Diagnostics {
                                capability-names: root.capability-names;
                                capability-flags: root.capability-flags;
                                capability-reasons: root.capability-reasons;
                            }
                        }
                    }
                }
            }
        }
    }
}
