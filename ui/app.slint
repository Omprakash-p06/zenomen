// ZenOmen application window — shell and screen router.
//
// Layout from `01-UI-SPEC.md` (Visual Hierarchy): a fixed 200px Charcoal
// sidebar, then a vertical stack of the 64px header, the 40px status strip and
// a scrolling content area with 24px padding. Sidebar and header stay fixed
// while content scrolls.
//
// Two rules this file exists to enforce:
//   * No hardware access: the shell only reads Slint properties and emits
//     callbacks. `src/app.rs` turns those callbacks into `AppCommand`s and is
//     the only path back in (FOUND-05).
//   * A bad screen index can never blank the window: every read goes through
//     `current-screen`, which falls back to Overview (T-01-04).
import { ThemeColors } from "theme/colors.slint";
import { ThemeTypography } from "theme/typography.slint";
import { ThemeMetrics } from "theme/metrics.slint";
import { ScrollView } from "std-widgets.slint";

import { Sidebar } from "components/sidebar.slint";
import { ScreenHeader } from "components/screen-header.slint";
import { StatusStrip } from "components/status-strip.slint";
import { Overview } from "screens/overview.slint";
import { Cooling } from "screens/cooling.slint";
import { Performance } from "screens/performance.slint";
import { Lighting } from "screens/lighting.slint";
import { Settings } from "screens/settings.slint";
import { Diagnostics } from "screens/diagnostics.slint";

export component AppWindow inherits Window {
    title: "ZenOmen";
    icon: @image-url("../data/icons/zenomen.svg");
    background: ThemeColors.obsidian;

    // 1180x760 default, 940x620 minimum: the sizes the Overview grid's 4- and
    // 3-column breakpoints were designed against. Slint names the initial size
    // `preferred-width`/`preferred-height`; there is no `default-width`
    // property on Window.
    preferred-width: ThemeMetrics.default-width;
    preferred-height: ThemeMetrics.default-height;
    min-width: ThemeMetrics.min-width;
    min-height: ThemeMetrics.min-height;

    /// Screen index requested by the sidebar or by the core. 0 = Overview.
    in-out property <int> active-screen: 0;

    // ---- Capability flags -------------------------------------------------
    // Granular per-subsystem truth from `HardwareCapabilities` (FOUND-04).
    // Each screen names the exact interface that is missing instead of showing
    // one coarse "unsupported" state. Defaults describe the Phase 1 mock
    // provider; `src/app.rs` overwrites them from `AppEvent::CapabilitiesLoaded`.
    in-out property <bool> has-cpu-metrics: true;
    in-out property <bool> has-gpu-metrics: true;
    in-out property <bool> has-ram-metrics: true;
    in-out property <bool> has-fan-rpm: true;
    in-out property <bool> has-fan-control: true;
    in-out property <bool> has-power-profiles: true;
    in-out property <bool> has-rgb-lighting: true;
    in-out property <bool> has-battery-metrics: true;

    // ---- Global status ----------------------------------------------------
    // The one line under the header. Written by `src/app.rs` from `AppState`;
    // the default here is the pre-sample copy, so the window is never blank
    // between launch and the first event.
    in-out property <string> status-text: "Waiting for first reading";
    in-out property <bool> status-degraded: false;

    // ---- About ------------------------------------------------------------
    in-out property <string> app-version: "0.1.0";
    in-out property <string> provider-mode: "mock";
    in-out property <string> theme-name: "Dark";

    // ---- Telemetry (already formatted by the core) ------------------------
    // The UI never reads a sensor and never invents a number: these are empty
    // or "Waiting for first reading" until a snapshot arrives.
    in-out property <string> cpu-utilization: "";
    in-out property <string> gpu-utilization: "";
    in-out property <string> gpu-temperature: "";
    in-out property <string> ram-usage: "";
    in-out property <string> fan-1-value: "";
    in-out property <string> fan-2-value: "";
    in-out property <string> fan-mode: "";
    in-out property <string> power-profile: "";
    in-out property <[string]> power-profile-choices: [];
    in-out property <string> rgb-profile: "";
    in-out property <string> rgb-variant: "Four-Zone";
    in-out property <string> rgb-profile-name: "White";
    in-out property <string> rgb-profile-desc: "Clean static white illumination on all 4 zones";
    in-out property <bool> rgb-power-enabled: true;
    in-out property <[color]> zone-colors: [#FFFFFF, #FFFFFF, #FFFFFF, #FFFFFF];
    in-out property <[string]> zone-hexes: ["#FFFFFF", "#FFFFFF", "#FFFFFF", "#FFFFFF"];
    in-out property <string> rgb-unsupported-fields: "";

    in-out property <string> cpu-sparkline: "";
    in-out property <string> gpu-sparkline: "";
    in-out property <string> ram-sparkline: "";
    in-out property <string> cpu-path: "";
    in-out property <string> gpu-path: "";
    in-out property <string> ram-path: "";

    in-out property <int> history-window: 120;
    in-out property <string> os-name: "Linux";
    in-out property <string> kernel-version: "Unknown";
    in-out property <string> model-name: "Unknown";
    in-out property <string> cpu-sensor: "Unavailable";
    in-out property <string> fan-count: "0";
    in-out property <string> export-status: "";

    in-out property <bool> service-connected: false;
    in-out property <string> pending-fan-mode: "";
    in-out property <string> pending-power-profile: "";
    in-out property <string> preset-result-message: "";
    in-out property <bool> preset-result-partial: false;
    in-out property <bool> preset-result-success: false;
    in-out property <string> service-status-text: "Disconnected";
    in-out property <string> polkit-status-text: "Unknown";
    in-out property <string> diag-service-title: "Hardware Control Service (com.zenomen.Hardware1)";
    in-out property <string> diag-auth-label: "Polkit Permissions:";
    in-out property <string> diag-sandboxing-label: "Sandboxing:";
    in-out property <string> diag-sandboxing-text: "ProtectSystem=strict, ReadWritePaths=/sys/devices/platform/hp-wmi /sys/firmware/acpi";
    in-out property <string> control-error-message: "";

    // ---- ZenOmen Process Memory Telemetry (WIN-08 / MON-12) ----------------
    in-out property <string> mem-zenomen-total: "Unavailable";
    in-out property <string> mem-zenomen-breakdown: "";
    in-out property <string> mem-gui-ws: "Unavailable";
    in-out property <string> mem-gui-private: "Unavailable";
    in-out property <string> mem-gui-peak: "Unavailable";
    in-out property <string> mem-gui-pid: "";
    in-out property <string> mem-service-ws: "Unavailable";
    in-out property <string> mem-service-private: "Unavailable";
    in-out property <string> mem-service-peak: "Unavailable";
    in-out property <string> mem-service-pid: "";
    in-out property <bool> mem-service-online: false;

    in-out property <int> polling-interval-ms: 1000;
    in-out property <bool> start-minimized: false;
    in-out property <bool> close-to-tray: true;
    in-out property <bool> autostart: false;
    in-out property <string> config-corrupt-notice: "";

    /// Emitted when history window duration is changed in Settings (MON-11).
    callback history-window-changed(int);
    /// Emitted when polling interval is changed in Settings (SYS-09).
    callback polling-interval-changed(int);
    /// Emitted when start minimized is toggled in Settings (SYS-03).
    callback start-minimized-toggled(bool);
    /// Emitted when close to tray is toggled in Settings (SYS-04).
    callback close-to-tray-toggled(bool);
    /// Emitted when autostart is toggled in Settings (SYS-02).
    callback autostart-toggled(bool);
    /// Emitted by the Export Diagnostics action in Diagnostics screen (DIAG-02).
    callback export-diagnostics();
    /// Emitted when user selects a fan mode ("auto", "max").
    callback set-fan-mode(string);
    /// Emitted when user selects a power profile.
    callback set-power-profile(string);
    /// Emitted when user applies a combined preset ("quiet", "balanced", "gaming").
    callback apply-preset(string);
    /// Emitted when user selects an RGB lighting preset ("white", "gaming", "rainbow", "off").
    callback apply-rgb-preset(string);
    /// Emitted when user toggles RGB lighting power state (RGB-04).
    callback set-rgb-power(bool);
    /// Emitted when user dismisses the control error notification banner.
    callback dismiss-control-error();
    /// Emitted when user clicks Check for updates in Settings (REL-06).
    callback open-releases-page();

    // ---- Diagnostics table ------------------------------------------------
    private property <[string]> capability-names: [
        "CPU metrics",
        "GPU metrics",
        "RAM metrics",
        "Fan speed (RPM)",
        "Fan control",
        "Power profiles",
        "RGB lighting",
        "Battery",
    ];
    private property <[bool]> capability-flags: [
        root.has-cpu-metrics,
        root.has-gpu-metrics,
        root.has-ram-metrics,
        root.has-fan-rpm,
        root.has-fan-control,
        root.has-power-profiles,
        root.has-rgb-lighting,
        root.has-battery-metrics,
    ];
    private property <[string]> capability-reasons: [
        root.has-cpu-metrics ? "" : (root.provider-mode == "windows" ? "PDH CPU performance counters unavailable." : "No CPU temperature hwmon device (coretemp/k10temp) found."),
        root.has-gpu-metrics ? "" : (root.provider-mode == "windows" ? "No DirectX/DXGI adapter or NVAPI device detected." : "No NVIDIA nvidia-smi or supported DRM card detected."),
        root.has-ram-metrics ? "" : (root.provider-mode == "windows" ? "GlobalMemoryStatusEx query failed." : "/proc/meminfo could not be read."),
        root.has-fan-rpm ? "" : (root.provider-mode == "windows" ? "HP BIOS does not expose hardware tachometer RPM readings on Windows." : "No fan tachometer found in hwmon."),
        root.has-fan-control ? "" : (root.provider-mode == "windows" ? "HP WMI fan control interface not exposed or service offline." : "hp-wmi exposes no writable pwm1_enable here."),
        root.has-power-profiles ? "" : (root.provider-mode == "windows" ? "HP WMI thermal profile interface not exposed or service offline." : "ACPI platform_profile sysfs interface not exposed."),
        root.has-rgb-lighting ? "" : (root.provider-mode == "windows" ? "HP WMI 4-zone or omen-rgb interface not detected." : "No supported OMEN 4-zone or legacy interface detected."),
        root.has-battery-metrics ? "" : (root.provider-mode == "windows" ? "GetSystemPowerStatus query failed." : "No /sys/class/power_supply battery device found."),
    ];

    /// Emitted when the user activates a nav row. `src/app.rs` forwards this
    /// to the core as `AppCommand::Navigate`.
    callback navigate(int);
    /// Emitted by the header's `Refresh Telemetry` action.
    callback refresh-telemetry();

    /// Index actually rendered. Out-of-range input degrades to Overview rather
    /// than rendering nothing (threat T-01-04).
    private property <int> current-screen:
        root.active-screen >= 0 && root.active-screen <= 5 ? root.active-screen : 0;

    // Title per screen, indexed by `current-screen`. A plain array keeps the
    // lookup inside a property binding (a function call would be impure).
    private property <[string]> screen-titles: [
        "Overview",
        "Cooling",
        "Performance",
        "Lighting",
        "Settings",
        "Diagnostics",
    ];

    // Root focus scope: Escape clears focus from the content and returns it to
    // the sidebar's active row (Keyboard & Interaction contract). Key events
    // from any focused descendant bubble up to here.
    shell-focus := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                sidebar.focus-active-row();
                return accept;
            }
            reject
        }

        HorizontalLayout {
            sidebar := Sidebar {
                active-screen: root.current-screen;
                navigate(screen) => {
                    root.active-screen = screen;
                    root.navigate(screen);
                }
            }

            VerticalLayout {
                spacing: 0;

                ScreenHeader {
                    title: root.screen-titles[root.current-screen];
                    // Only Overview has a primary action in Phase 1.
                    show-action: root.current-screen == 0;
                    action-label: "Refresh Telemetry";
                    action => {
                        root.refresh-telemetry();
                    }
                }

                // Global capability / provider state, directly under the header
                // so it is read before the screen anchor (UI-SPEC reading order).
                // Both values come from `src/app.rs`; nothing here decides
                // whether the machine is degraded.
                StatusStrip {
                    text: root.status-text;
                    degraded: root.status-degraded;
                    // A degraded machine always offers the way to the reason.
                    show-action: root.status-degraded;
                    action => {
                        root.active-screen = 5;
                        root.navigate(5);
                    }
                }

                // Content viewport: 24px padding, one scrolling surface. The
                // router keys on `current-screen`; every screen is instantiated
                // here so the Slint compiler type-checks each of them.
                content-viewport := Rectangle {
                    background: ThemeColors.obsidian;
                    vertical-stretch: 1;

                    ScrollView {
                        width: 100%;
                        height: 100%;

                        HorizontalLayout {
                            alignment: center;
                            padding: ThemeMetrics.lg;

                            Rectangle {
                                width: min(content-viewport.width - 2 * ThemeMetrics.lg, 1040px);

                                VerticalLayout {
                                    spacing: ThemeMetrics.lg;
                                    alignment: stretch;

                            if root.current-screen == 0 : Overview {
                                has-cpu-metrics: root.has-cpu-metrics;
                                has-gpu-metrics: root.has-gpu-metrics;
                                has-ram-metrics: root.has-ram-metrics;
                                has-fan-rpm: root.has-fan-rpm;
                                cpu-utilization: root.cpu-utilization;
                                gpu-utilization: root.gpu-utilization;
                                gpu-temperature: root.gpu-temperature;
                                ram-usage: root.ram-usage;
                                fan-1-value: root.fan-1-value;
                                fan-2-value: root.fan-2-value;
                                cpu-sparkline: root.cpu-sparkline;
                                gpu-sparkline: root.gpu-sparkline;
                                ram-sparkline: root.ram-sparkline;
                                cpu-path: root.cpu-path;
                                gpu-path: root.gpu-path;
                                ram-path: root.ram-path;
                                zenomen-memory: root.mem-zenomen-total;
                                zenomen-memory-breakdown: root.mem-zenomen-breakdown;
                                open-diagnostics => {
                                    root.active-screen = 5;
                                    root.navigate(5);
                                }
                            }

                            if root.current-screen == 1 : Cooling {
                                has-fan-rpm: root.has-fan-rpm;
                                has-fan-control: root.has-fan-control;
                                service-connected: root.service-connected;
                                is-windows: root.provider-mode == "windows";
                                fan-mode: root.fan-mode;
                                pending-fan-mode: root.pending-fan-mode;
                                control-error-message: root.control-error-message;
                                fan-values: [root.fan-1-value, root.fan-2-value];
                                set-fan-mode(mode) => {
                                    root.set-fan-mode(mode);
                                }
                                dismiss-error => {
                                    root.dismiss-control-error();
                                }
                                open-diagnostics => {
                                    root.active-screen = 5;
                                    root.navigate(5);
                                }
                            }

                            if root.current-screen == 2 : Performance {
                                has-power-profiles: root.has-power-profiles;
                                service-connected: root.service-connected;
                                is-windows: root.provider-mode == "windows";
                                power-profile: root.power-profile;
                                power-profile-choices: root.power-profile-choices;
                                pending-power-profile: root.pending-power-profile;
                                preset-result-message: root.preset-result-message;
                                preset-result-partial: root.preset-result-partial;
                                preset-result-success: root.preset-result-success;
                                control-error-message: root.control-error-message;
                                set-power-profile(p) => {
                                    root.set-power-profile(p);
                                }
                                apply-preset(p) => {
                                    root.apply-preset(p);
                                }
                                dismiss-error => {
                                    root.dismiss-control-error();
                                }
                                open-diagnostics => {
                                    root.active-screen = 5;
                                    root.navigate(5);
                                }
                            }

                            if root.current-screen == 3 : Lighting {
                                has-rgb-lighting: root.has-rgb-lighting;
                                is-windows: root.provider-mode == "windows";
                                rgb-variant: root.rgb-variant;
                                active-profile-name: root.rgb-profile-name;
                                active-profile-desc: root.rgb-profile-desc;
                                rgb-power-enabled: root.rgb-power-enabled;
                                zone-colors: root.zone-colors;
                                zone-hexes: root.zone-hexes;
                                control-error-message: root.control-error-message;
                                unsupported-fields: root.rgb-unsupported-fields;
                                apply-preset(preset) => {
                                    root.apply-rgb-preset(preset);
                                }
                                set-rgb-power(enabled) => {
                                    root.set-rgb-power(enabled);
                                }
                                dismiss-error => {
                                    root.dismiss-control-error();
                                }
                                open-diagnostics => {
                                    root.active-screen = 5;
                                    root.navigate(5);
                                }
                            }

                            if root.current-screen == 4 : Settings {
                                app-version: root.app-version;
                                provider-mode: root.provider-mode;
                                theme-name: root.theme-name;
                                history-window: root.history-window;
                                polling-interval-ms: root.polling-interval-ms;
                                start-minimized: root.start-minimized;
                                close-to-tray: root.close-to-tray;
                                autostart: root.autostart;
                                config-corrupt-notice: root.config-corrupt-notice;
                                history-window-changed(val) => {
                                    root.history-window = val;
                                    root.history-window-changed(val);
                                }
                                polling-interval-changed(val) => {
                                    root.polling-interval-ms = val;
                                    root.polling-interval-changed(val);
                                }
                                start-minimized-toggled(val) => {
                                    root.start-minimized = val;
                                    root.start-minimized-toggled(val);
                                }
                                close-to-tray-toggled(val) => {
                                    root.close-to-tray = val;
                                    root.close-to-tray-toggled(val);
                                }
                                autostart-toggled(val) => {
                                    root.autostart = val;
                                    root.autostart-toggled(val);
                                }
                                open-releases-page => {
                                    root.open-releases-page();
                                }
                            }

                            if root.current-screen == 5 : Diagnostics {
                                os-name: root.os-name;
                                kernel-version: root.kernel-version;
                                model-name: root.model-name;
                                cpu-sensor: root.cpu-sensor;
                                fan-count: root.fan-count;
                                export-status: root.export-status;
                                service-status: root.service-status-text;
                                polkit-status: root.polkit-status-text;
                                service-title: root.diag-service-title;
                                auth-label: root.diag-auth-label;
                                isolation-label: root.diag-sandboxing-label;
                                isolation-text: root.diag-sandboxing-text;
                                capability-names: root.capability-names;
                                capability-flags: root.capability-flags;
                                capability-reasons: root.capability-reasons;
                                mem-gui-ws: root.mem-gui-ws;
                                mem-gui-private: root.mem-gui-private;
                                mem-gui-peak: root.mem-gui-peak;
                                mem-gui-pid: root.mem-gui-pid;
                                mem-service-ws: root.mem-service-ws;
                                mem-service-private: root.mem-service-private;
                                mem-service-peak: root.mem-service-peak;
                                mem-service-pid: root.mem-service-pid;
                                mem-zenomen-total: root.mem-zenomen-total;
                                mem-service-online: root.mem-service-online;
                                export-diagnostics-clicked => {
                                    root.export-diagnostics();
                                }
                            }
                        }
                    }
                }
            }
        }
            }
        }
    }
}
