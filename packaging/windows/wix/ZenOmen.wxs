<!-- WiX v4/v5 installer definition for ZenOmen -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="ZenOmen"
           Manufacturer="ZenOmen Project"
           Version="0.1.0"
           UpgradeCode="4E1A9D5B-3B9B-4D78-9B92-7E5A2A1A7D10"
           Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of ZenOmen is already installed."
                  Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="zenomen.ico" SourceFile="data/icons/zenomen.ico" />
    <Property Id="ARPPRODUCTICON" Value="zenomen.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ZenOmen">
        <Component Id="ZenOmenGui" Guid="8B3F2E1A-7C4D-4E9A-8F2B-1D3C5E7A9B01">
          <File Id="zenomen.exe" Source="target/release/zenomen.exe" KeyPath="yes" />
          <Shortcut Id="ZenOmenDesktopShortcut"
                    Directory="DesktopFolder"
                    Name="ZenOmen"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="zenomen.ico"
                    Advertise="no" />
          <Shortcut Id="ZenOmenProgramMenuShortcut"
                    Directory="ProgramMenuFolder"
                    Name="ZenOmen"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="zenomen.ico"
                    Advertise="no" />
        </Component>

        <Component Id="ZenOmenHardwareService" Guid="9C4A3F2B-8D5E-4F0B-9A3C-2E4D6F8B0C12">
          <File Id="zenomen_hw.exe" Source="target/release/zenomen-hw.exe" KeyPath="yes" />
          <ServiceInstall Id="ServiceInstaller"
                          Type="ownProcess"
                          Name="ZenOmenHardwareService"
                          DisplayName="ZenOmen Hardware Control Service"
                          Description="Provides elevated hardware control for HP OMEN and Victus laptops via secure named-pipe IPC."
                          Start="auto"
                          Account="NT AUTHORITY\LocalSystem"
                          ErrorControl="normal"
                          Interactive="no">
            <ServiceConfig DelayedAutoStart="yes" OnInstall="yes" OnReinstall="yes" />
          </ServiceInstall>
          <ServiceControl Id="ServiceControl"
                          Name="ZenOmenHardwareService"
                          Start="install"
                          Stop="both"
                          Remove="uninstall"
                          Wait="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainApplication" Title="ZenOmen Application" Level="1">
      <ComponentRef Id="ZenOmenGui" />
      <ComponentRef Id="ZenOmenHardwareService" />
    </Feature>
  </Package>
</Wix>
