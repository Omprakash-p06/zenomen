#!/bin/sh
set -e

case "$1" in
    configure)
        # Reload systemd manager configuration
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi

        # Reload D-Bus system bus configuration
        if [ -x /usr/bin/systemctl ] && [ -d /run/systemd/system ]; then
            systemctl reload dbus >/dev/null 2>&1 || true
        fi

        # Enable and start the hardware control service
        if [ -x /usr/bin/systemctl ] && [ -d /run/systemd/system ]; then
            systemctl enable zenomen-hw.service >/dev/null 2>&1 || true
            systemctl restart zenomen-hw.service >/dev/null 2>&1 || true
        fi

        # Update desktop application database
        if [ -x /usr/bin/update-desktop-database ]; then
            update-desktop-database -q /usr/share/applications >/dev/null 2>&1 || true
        fi

        # Update icon cache
        if [ -x /usr/bin/gtk-update-icon-cache ]; then
            gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        ;;
esac

exit 0
